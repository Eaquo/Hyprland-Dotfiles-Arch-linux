 /* wallust template - colors-rofi */

* {
active-background: #7E6D5F;
active-foreground: #E4DCD5;
normal-background: #111112;
normal-foreground: #E4DCD5;
urgent-background: #6E7E7B;
urgent-foreground: #E4DCD5;

alternate-active-background: #7E6D5F;
alternate-active-foreground: #E4DCD5;
alternate-normal-background: #111112;
alternate-normal-foreground: #E4DCD5;
alternate-urgent-background: #111112;
alternate-urgent-foreground: #E4DCD5;

selected-active-background: #485150;
selected-active-foreground: #E4DCD5;
selected-normal-background: #485150;
selected-normal-foreground: #E4DCD5;
selected-urgent-background: #6E7E7B;
selected-urgent-foreground: #E4DCD5;

background-color: #111112;
background: rgba(0,0,0,0.7);
foreground: #E4DCD5;
border-color: #485150;

color0: #393A3A;
color1: #0A0D0E;
color2: #0B0E0E;
color3: #363D3C;
color4: #5E5247;
color5: #535E5C;
color6: #867464;
color7: #D0C5BA;
