 /* wallust template - colors-rofi */

* {
active-background: #C48738;
active-foreground: #FFEEC0;
normal-background: #140000;
normal-foreground: #FFEEC0;
urgent-background: #F5C249;
urgent-foreground: #FFEEC0;

alternate-active-background: #C48738;
alternate-active-foreground: #FFEEC0;
alternate-normal-background: #140000;
alternate-normal-foreground: #FFEEC0;
alternate-urgent-background: #140000;
alternate-urgent-foreground: #FFEEC0;

selected-active-background: #887F7F;
selected-active-foreground: #FFEEC0;
selected-normal-background: #887F7F;
selected-normal-foreground: #FFEEC0;
selected-urgent-background: #F5C249;
selected-urgent-foreground: #FFEEC0;

background-color: #140000;
background: rgba(0,0,0,0.7);
foreground: #FFEEC0;
border-color: #887F7F;

color0: #140000;
color1: #764220;
color2: #973807;
color3: #665F5F;
color4: #93652A;
color5: #B89236;
color6: #BF9B39;
color7: #F6DE9D;
color8: #AD9B6E;
color9: #9D582A;
color10: #C94A09;
color11: #887F7F;
color12: #C48738;
color13: #F5C249;
color14: #FFCE4C;
color15: #F6DE9D;


}
