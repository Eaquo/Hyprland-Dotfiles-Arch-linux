 /* wallust template - colors-rofi */

* {
active-background: #E35510;
active-foreground: #FCF986;
normal-background: #010001;
normal-foreground: #FCF986;
urgent-background: #EBAE4F;
urgent-foreground: #FCF986;

alternate-active-background: #E35510;
alternate-active-foreground: #FCF986;
alternate-normal-background: #010001;
alternate-normal-foreground: #FCF986;
alternate-urgent-background: #010001;
alternate-urgent-foreground: #FCF986;

selected-active-background: #C36A33;
selected-active-foreground: #FCF986;
selected-normal-background: #C36A33;
selected-normal-foreground: #FCF986;
selected-urgent-background: #EBAE4F;
selected-urgent-foreground: #FCF986;

background-color: #010001;
background: rgba(0,0,0,0.7);
foreground: #FCF986;
border-color: #C36A33;

color0: #010001;
color1: #5D4540;
color2: #714C44;
color3: #8E6850;
color4: #9C5F41;
color5: #917241;
color6: #8B772C;
color7: #FCF986;
color8: #1C1C1C;
color9: #784F45;
color10: #9B5B4B;
color11: #C36A33;
color12: #E35510;
color13: #EBAE4F;
color14: #F6D44F;
color15: #FCF986;


}
