 /* wallust template - colors-rofi */

* {
active-background: #BB1A5A;
active-foreground: #FCEDE7;
normal-background: #120F17;
normal-foreground: #FCEDE7;
urgent-background: #C61B5D;
urgent-foreground: #FCEDE7;

alternate-active-background: #BB1A5A;
alternate-active-foreground: #FCEDE7;
alternate-normal-background: #120F17;
alternate-normal-foreground: #FCEDE7;
alternate-urgent-background: #120F17;
alternate-urgent-foreground: #FCEDE7;

selected-active-background: #6D1245;
selected-active-foreground: #FCEDE7;
selected-normal-background: #6D1245;
selected-normal-foreground: #FCEDE7;
selected-urgent-background: #C61B5D;
selected-urgent-foreground: #FCEDE7;

background-color: #120F17;
background: rgba(0,0,0,0.7);
foreground: #FCEDE7;
border-color: #6D1245;

color0: #3A383F;
color1: #170825;
color2: #430A36;
color3: #520E34;
color4: #8C1344;
color5: #951446;
color6: #B8988C;
color7: #F2DDD4;
color8: #A99A95;
color9: #1F0A31;
color10: #590D48;
color11: #6D1245;
color12: #BB1A5A;
color13: #C61B5D;
color14: #F6CBBB;
color15: #F2DDD4;


}
