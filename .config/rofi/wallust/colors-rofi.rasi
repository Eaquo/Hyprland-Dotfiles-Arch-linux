 /* wallust template - colors-rofi */

* {
active-background: #CF1D39;
active-foreground: #FCF4FA;
normal-background: #150000;
normal-foreground: #FCF4FA;
urgent-background: #F66890;
urgent-foreground: #FCF4FA;

alternate-active-background: #CF1D39;
alternate-active-foreground: #FCF4FA;
alternate-normal-background: #150000;
alternate-normal-foreground: #FCF4FA;
alternate-urgent-background: #150000;
alternate-urgent-foreground: #FCF4FA;

selected-active-background: #C31B35;
selected-active-foreground: #FCF4FA;
selected-normal-background: #C31B35;
selected-normal-foreground: #FCF4FA;
selected-urgent-background: #F66890;
selected-urgent-foreground: #FCF4FA;

background-color: #150000;
background: rgba(0,0,0,0.7);
foreground: #FCF4FA;
border-color: #C31B35;

color0: #150000;
color1: #510A16;
color2: #560A17;
color3: #921428;
color4: #9B162B;
color5: #B84E6C;
color6: #B8A7B4;
color7: #F2E7EF;
color8: #A9A1A7;
color9: #6D0D1D;
color10: #730E1F;
color11: #C31B35;
color12: #CF1D39;
color13: #F66890;
color14: #F6DFF0;
color15: #F2E7EF;


}
