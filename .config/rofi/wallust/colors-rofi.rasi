 /* wallust template - colors-rofi */

* {
active-background: #BC5C2A;
active-foreground: #EBEDBA;
normal-background: #0C0000;
normal-foreground: #EBEDBA;
urgent-background: #98C3AF;
urgent-foreground: #EBEDBA;

alternate-active-background: #BC5C2A;
alternate-active-foreground: #EBEDBA;
alternate-normal-background: #0C0000;
alternate-normal-foreground: #EBEDBA;
alternate-urgent-background: #0C0000;
alternate-urgent-foreground: #EBEDBA;

selected-active-background: #9D4F2B;
selected-active-foreground: #EBEDBA;
selected-normal-background: #9D4F2B;
selected-normal-foreground: #EBEDBA;
selected-urgent-background: #98C3AF;
selected-urgent-foreground: #EBEDBA;

background-color: #0C0000;
background: rgba(0,0,0,0.7);
foreground: #EBEDBA;
border-color: #9D4F2B;

color0: #0C0000;
color1: #482721;
color2: #32376A;
color3: #763B20;
color4: #8D451F;
color5: #729283;
color6: #94982C;
color7: #DADD94;
color8: #989A68;
color9: #60352C;
color10: #43498D;
color11: #9D4F2B;
color12: #BC5C2A;
color13: #98C3AF;
color14: #C5CB3A;
color15: #DADD94;


}
