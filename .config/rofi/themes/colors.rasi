configuration {
    font:                           "Fira Sans 13";
    hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}


* {
    background-color:       transparent;
    background:             rgba(0,0,0,0.7);
    background-transparent: #010001;
    text-color:             #D8DEE9;
    primary:                #C36A33;
    secondary:              #1C1C1C;
    urgent:                 #EBAE4F;
}
