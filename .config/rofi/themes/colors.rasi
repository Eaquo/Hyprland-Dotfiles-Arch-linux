configuration {
    font:                           "Fira Sans 13";
    hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}


* {
    background-color:       transparent;
    background:             rgba(0,0,0,0.7);
    background-transparent: #140000;
    text-color:             #D8DEE9;
    primary:                #887F7F;
    secondary:              #AD9B6E;
    urgent:                 #F5C249;
}
