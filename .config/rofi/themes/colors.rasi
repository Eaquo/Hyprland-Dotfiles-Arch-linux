configuration {
    font:                           "Fira Sans 13";
    hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}


* {
    background-color:       transparent;
    background:             rgba(0,0,0,0.7);
    background-transparent: #150000;
    text-color:             #D8DEE9;
    primary:                #C31B35;
    secondary:              #A9A1A7;
    urgent:                 #F66890;
}
