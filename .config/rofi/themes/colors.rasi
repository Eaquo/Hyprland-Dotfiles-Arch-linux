configuration {
    font:                           "Fira Sans 13";
    hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}


* {
    background-color:       transparent;
    background:             rgba(0,0,0,0.7);
    background-transparent: #120F17;
    text-color:             #D8DEE9;
    primary:                #6D1245;
    secondary:              #A99A95;
    urgent:                 #C61B5D;
}
