configuration {
    font:                           "Fira Sans 13";
    hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}


* {
    background-color:       transparent;
    background:             rgba(0,0,0,0.7);
    background-transparent: #0C0000;
    text-color:             #D8DEE9;
    primary:                #9D4F2B;
    secondary:              #989A68;
    urgent:                 #98C3AF;
}
