configuration {
    font:                           "Fira Sans 13";
    hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}


* {
    background-color:       transparent;
    background:             rgba(0,0,0,0.7);
    background-transparent: #111112;
    text-color:             #D8DEE9;
    primary:                #485150;
    secondary:              #928A82;
    urgent:                 #6E7E7B;
}
